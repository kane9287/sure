<%# Confirm and reject both land here. Replacing the whole list rather than
    removing one card keeps the empty state honest when the last pair is
    resolved, and costs one already-loaded collection. %>
<%= turbo_stream.replace "transaction-reconciliations-list" do %>
  <%= render "transaction_reconciliations/list", reconciliations: @reconciliations %>
<% end %>

<% flash_notification_stream_items.each do |item| %>
  <%= item %>
<% end %>
