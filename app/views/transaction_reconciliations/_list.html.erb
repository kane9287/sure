<%# locals: (reconciliations:) %>

<div id="transaction-reconciliations-list" class="space-y-3">
  <% if reconciliations.any? %>
    <% reconciliations.each do |reconciliation| %>
      <%= render "transaction_reconciliations/reconciliation_card", reconciliation: reconciliation %>
    <% end %>
  <% else %>
    <%= render DS::EmptyState.new(
      icon: "git-merge",
      title: t("transaction_reconciliations.index.empty.title"),
      description: t("transaction_reconciliations.index.empty.description")
    ) %>
  <% end %>
</div>
