<%# locals: (budget:) %>

<% family = budget.family %>
<% total_cash = family.in_budget_cash_balance %>
<% unassigned = family.unassigned_pool_balance %>
<%# Derived from the headline rather than re-summed so the bar and the
    Unassigned figure can never disagree. %>
<% assigned = total_cash.amount - unassigned.amount %>
<% percent_assigned = total_cash.amount.positive? ? (assigned / total_cash.amount.to_f * 100).clamp(0, 100) : 0 %>

<div id="<%= dom_id(family, :unassigned_pool) %>" class="bg-container rounded-xl shadow-border-xs p-4 mb-4 space-y-3">
  <div class="flex items-center justify-between gap-4">
    <div>
      <p class="text-sm text-secondary"><%= t(".title") %></p>
      <p class="text-2xl font-medium privacy-sensitive <%= unassigned.negative? ? "text-destructive" : "text-primary" %>">
        <%= format_money(unassigned) %>
      </p>
      <p class="text-xs text-secondary mt-0.5"><%= t(".subtitle") %></p>
    </div>

    <%= render DS::Link.new(
      text: t(".allocate"),
      variant: "secondary",
      icon: "hand-coins",
      href: budget_budget_categories_path(budget)
    ) %>
  </div>

  <div class="space-y-2">
    <div class="flex items-center gap-2">
      <p class="text-secondary text-sm"><%= t(".percent_assigned", percent: number_to_percentage(percent_assigned, precision: 0)) %></p>

      <p class="ml-auto text-sm space-x-1">
        <span class="text-primary privacy-sensitive"><%= format_money(Money.new(assigned, total_cash.currency)) %></span>
        <span class="text-secondary"> / </span>
        <span class="text-secondary privacy-sensitive"><%= format_money(total_cash) %></span>
      </p>
    </div>

    <div class="relative h-1.5 rounded-2xl bg-surface-inset">
      <div class="absolute inset-0 bg-inverse rounded-2xl" style="width: <%= percent_assigned %>%;"></div>
    </div>
  </div>
</div>
