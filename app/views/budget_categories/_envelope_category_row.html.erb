<%# locals: (budget_category:, budget:) %>

<% goal_target = budget.envelope_goal_target_for(budget_category.category_id) %>
<% assigned_this_period = budget_category.envelope_assigned %>
<%# The box holds the period's assigned total, not an amount to add, so it
    starts at whatever is already assigned. A goal's monthly target pulls it up
    to that target so hitting the goal stays one click — but only upward, so
    prefilling never proposes taking money back out. %>
<% goal_monthly = goal_target && goal_target[:monthly_money]&.amount %>
<% assigned_prefill = sprintf("%.2f", [ assigned_this_period, goal_monthly || 0 ].max) %>

<div id="<%= dom_id(budget_category, :envelope_row) %>" class="w-full flex gap-3 py-3 items-start">
  <div class="w-1 h-3 rounded-xl mt-1 flex-shrink-0" style="background-color: <%= budget_category.category.color %>"></div>

  <div class="text-sm mr-3 min-w-0 flex-1">
    <p class="text-primary font-medium mb-0.5 truncate"><%= budget_category.category.display_name %></p>
    <p class="text-secondary privacy-sensitive"><%= t("budget_categories.budget_category_form.monthly_average", amount: budget_category.median_monthly_expense_money.format(precision: 0)) %></p>

    <p class="text-xs text-secondary mt-1 flex items-center gap-2">
      <span><%= t(".available") %>:</span>

      <% if budget_category.available_to_spend >= 0 %>
        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium bg-success/10 text-success privacy-sensitive whitespace-nowrap">
          <%= format_money(budget_category.available_to_spend_money) %>
        </span>
      <% else %>
        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium bg-destructive/10 text-destructive privacy-sensitive whitespace-nowrap">
          <%= t(".overspent_by", amount: format_money(budget_category.available_to_spend_money.abs)) %>
        </span>
      <% end %>
    </p>

    <% if goal_target %>
      <p class="text-xs text-secondary mt-1 flex items-center gap-1.5 flex-wrap">
        <%= icon "target", size: "xs", color: "current" %>
        <%= link_to goal_target[:goal].name, goal_path(goal_target[:goal]), class: "text-primary hover:underline" %>
        <% if goal_target[:monthly_money] %>
          <span class="privacy-sensitive"><%= t(".goal_target", amount: goal_target[:monthly_money].format(precision: 0)) %></span>
          <% if goal_target[:still_needed_money].positive? %>
            <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium bg-warning/10 text-warning privacy-sensitive whitespace-nowrap">
              <%= t(".goal_still_needed", amount: goal_target[:still_needed_money].format(precision: 0)) %>
            </span>
          <% else %>
            <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium bg-success/10 text-success whitespace-nowrap">
              <%= t(".goal_funded") %>
            </span>
          <% end %>
        <% end %>
      </p>
    <% end %>

    <%# Available on every envelope, not just overspent ones: pulling from a
        healthy envelope is how you rebalance mid-period once you know a
        category came in under. Opened by default when overspent, where it's
        the fix rather than an optimisation. %>
    <details class="mt-2" <%= "open" if budget_category.available_to_spend.negative? %>>
      <summary class="text-xs text-secondary cursor-pointer w-fit"><%= t(".move_money") %></summary>

      <% source_options = budget.budget_categories.reject { |bc| bc.category_id == budget_category.category_id }
           .map { |bc| [ "#{bc.category.display_name} (#{format_money(bc.available_to_spend_money)})", bc.category_id ] } %>
      <%# Both forms on this row post budget_allocation[amount], and the row
          itself repeats per category, so every field needs an id of its own. %>
      <%= form_with url: budget_budget_allocations_path(budget), method: :post, data: { turbo: false } do |f| %>
        <%= f.hidden_field "budget_allocation[category_id]", value: budget_category.category_id, id: dom_id(budget_category, :envelope_move_category) %>
        <div class="flex items-center gap-2 mt-2">
          <%= f.select "budget_allocation[from_category_id]",
              source_options,
              { include_blank: t(".move_from_placeholder") },
              { class: "form-field__input text-sm", id: dom_id(budget_category, :envelope_move_source) } %>
          <%= f.text_field "budget_allocation[amount]", placeholder: "0.00", class: "form-field__input text-sm w-20", id: dom_id(budget_category, :envelope_move_amount) %>
          <%= render DS::Button.new(text: t(".move"), type: :submit, variant: "secondary", size: "sm") %>
        </div>
      <% end %>
    </details>
  </div>

  <div class="ml-auto flex-shrink-0 w-[130px]">
    <%= form_with url: budget_budget_allocations_path(budget), method: :post, data: { turbo: false } do |f| %>
      <%= f.hidden_field "budget_allocation[category_id]", value: budget_category.category_id, id: dom_id(budget_category, :envelope_assign_category) %>
      <%= f.hidden_field "budget_allocation[kind]", value: "set", id: dom_id(budget_category, :envelope_assign_kind) %>
      <label class="block text-xs text-secondary mb-1 text-right" for="<%= dom_id(budget_category, :envelope_assigned) %>">
        <%= t(".assigned") %>
      </label>
      <div class="form-field">
        <div class="flex items-center privacy-sensitive privacy-sensitive-interactive">
          <span class="text-secondary text-sm mr-2"><%= Money::Currency.new(budget.currency).symbol %></span>
          <%= f.text_field "budget_allocation[amount]",
                id: dom_id(budget_category, :envelope_assigned),
                value: assigned_prefill,
                class: "form-field__input text-right",
                placeholder: "0.00" %>
        </div>
      </div>
      <%= render DS::Button.new(text: t(".update"), type: :submit, variant: "secondary", size: "sm", full_width: true, class: "mt-2") %>
    <% end %>
  </div>
</div>
