<%# locals: (budget_category:, budget:) %>

<div id="<%= dom_id(budget_category, :envelope_row) %>" class="w-full bg-container-inset rounded-lg p-3 space-y-2">
  <div class="flex items-center gap-3">
    <div class="w-2 h-2 rounded-full flex-shrink-0" style="background-color: <%= budget_category.category.color %>"></div>
    <p class="text-sm font-medium text-primary flex-1 min-w-0 truncate"><%= budget_category.category.display_name %></p>

    <span class="text-xs text-secondary whitespace-nowrap">
      <%= t(".assigned") %>: <span class="privacy-sensitive"><%= format_money(budget_category.envelope_assigned_money) %></span>
    </span>

    <% if budget_category.available_to_spend >= 0 %>
      <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-success/10 text-success privacy-sensitive whitespace-nowrap">
        <%= format_money(budget_category.available_to_spend_money) %>
      </span>
    <% else %>
      <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-destructive/10 text-destructive privacy-sensitive whitespace-nowrap">
        <%= format_money(budget_category.available_to_spend_money.abs) %>
      </span>
    <% end %>
  </div>

  <%= form_with url: budget_budget_allocations_path(budget), method: :post, data: { turbo: false } do |f| %>
    <%= f.hidden_field "budget_allocation[category_id]", value: budget_category.category_id %>
    <%= f.hidden_field "budget_allocation[kind]", value: "fund" %>
    <div class="flex items-center gap-2">
      <%= f.text_field "budget_allocation[amount]", placeholder: "0.00", class: "form-field__input text-sm" %>
      <%= render DS::Button.new(text: t(".fund"), type: :submit, variant: "secondary", size: "sm") %>
    </div>
  <% end %>

  <% if budget_category.available_to_spend.negative? %>
    <% source_options = budget.budget_categories.reject { |bc| bc.category_id == budget_category.category_id }
         .map { |bc| [ "#{bc.category.display_name} (#{format_money(bc.available_to_spend_money)})", bc.category_id ] } %>
    <%= form_with url: budget_budget_allocations_path(budget), method: :post, data: { turbo: false } do |f| %>
      <%= f.hidden_field "budget_allocation[category_id]", value: budget_category.category_id %>
      <%= f.hidden_field "budget_allocation[kind]", value: "fund" %>
      <div class="flex items-center gap-2">
        <%= f.select "budget_allocation[from_category_id]",
            source_options,
            { include_blank: t(".move_from_placeholder") },
            { class: "form-field__input text-sm" } %>
        <%= f.text_field "budget_allocation[amount]", placeholder: "0.00", class: "form-field__input text-sm w-20" %>
        <%= render DS::Button.new(text: t(".move"), type: :submit, variant: "secondary", size: "sm") %>
      </div>
    <% end %>
  <% end %>
</div>
