<%# locals: (budget_category:, budget:) %>

<%# The built-in Debt Payment envelope. Unlike every other row there's no
    "set assigned to X" box: the reserve is derived from card activity, so the
    only meaningful action is topping up what isn't covered yet. %>
<% debt_reserve = Family::DebtReserve.new(budget.family) %>

<div id="<%= dom_id(budget_category, :envelope_row) %>" class="w-full flex gap-3 py-3 items-start bg-container-inset rounded-lg px-3">
  <div class="w-1 h-3 rounded-xl mt-1 flex-shrink-0" style="background-color: <%= budget_category.category.color %>"></div>

  <div class="text-sm mr-3 min-w-0 flex-1">
    <p class="text-primary font-medium mb-0.5 flex items-center gap-2 flex-wrap">
      <span class="truncate"><%= budget_category.category.display_name %></span>
      <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium bg-surface-inset text-secondary whitespace-nowrap">
        <%= t("categories.category.built_in") %>
      </span>
    </p>
    <p class="text-secondary text-xs"><%= t(".subtitle") %></p>

    <p class="text-xs text-secondary mt-2 flex items-center gap-2">
      <span><%= t(".reserved") %>:</span>
      <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium bg-success/10 text-success privacy-sensitive whitespace-nowrap">
        <%= format_money(debt_reserve.reserved_money) %>
      </span>
    </p>

    <% if debt_reserve.any_debt? %>
      <details class="mt-2">
        <summary class="text-xs text-secondary cursor-pointer w-fit">
          <%= t(".total_debt", amount: format_money(debt_reserve.total_debt_money)) %>
        </summary>

        <ul class="mt-2 space-y-1">
          <% debt_reserve.lines.each do |line| %>
            <li class="text-xs flex items-center justify-between gap-4">
              <span class="text-secondary truncate"><%= line.account.name %></span>
              <span class="text-primary privacy-sensitive whitespace-nowrap"><%= format_money(line.balance_money) %></span>
            </li>
          <% end %>
        </ul>
      </details>
    <% end %>
  </div>

  <div class="ml-auto flex-shrink-0 w-[130px]">
    <% if debt_reserve.fully_reserved? %>
      <p class="text-xs text-right">
        <span class="inline-flex items-center rounded-full px-2 py-0.5 font-medium bg-success/10 text-success whitespace-nowrap">
          <%= t(".fully_reserved") %>
        </span>
      </p>
    <% else %>
      <%# Debt carried in before envelope mode was switched on has no reserve
          behind it, so it has to be funded like any other envelope. %>
      <%= form_with url: budget_budget_allocations_path(budget), method: :post, data: { turbo: false } do |f| %>
        <%= f.hidden_field "budget_allocation[category_id]", value: budget_category.category_id, id: dom_id(budget_category, :envelope_debt_category) %>
        <%= f.hidden_field "budget_allocation[kind]", value: "fund", id: dom_id(budget_category, :envelope_debt_kind) %>
        <label class="block text-xs text-warning mb-1 text-right" for="<%= dom_id(budget_category, :envelope_debt_amount) %>">
          <%= t(".unreserved", amount: format_money(debt_reserve.unreserved_money)) %>
        </label>
        <div class="form-field">
          <div class="flex items-center privacy-sensitive privacy-sensitive-interactive">
            <span class="text-secondary text-sm mr-2"><%= Money::Currency.new(budget.currency).symbol %></span>
            <%= f.text_field "budget_allocation[amount]",
                  id: dom_id(budget_category, :envelope_debt_amount),
                  value: debt_reserve.unreserved_prefill,
                  class: "form-field__input text-right",
                  placeholder: "0.00" %>
          </div>
        </div>
        <%= render DS::Button.new(text: t(".reserve_action"), type: :submit, variant: "secondary", size: "sm", full_width: true, class: "mt-2") %>
      <% end %>
      <p class="text-xs text-secondary mt-1 text-right"><%= t(".unreserved_hint") %></p>
    <% end %>
  </div>
</div>
