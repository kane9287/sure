<%# locals: (debt_plan:) %>

<% result = debt_plan.schedule %>

<%= link_to debt_plan_path(debt_plan), class: "block bg-container rounded-xl shadow-border-xs p-5 hover:bg-surface-hover focus-ring" do %>
  <div class="flex items-start justify-between gap-2">
    <div class="min-w-0">
      <p class="text-sm font-medium text-primary truncate"><%= debt_plan.name %></p>
      <p class="text-xs text-secondary mt-0.5">
        <%= t("debt_plans.strategies.#{debt_plan.strategy}") %>
        <span class="text-subdued">·</span>
        <%= t(".debt_count", count: debt_plan.debts.size) %>
      </p>
    </div>
    <%= render DS::Pill.new(
          label: t("debt_plans.status.#{result.status}.pill"),
          tone: result.paid_off? ? :success : :warning,
          marker: false
        ) %>
  </div>

  <p class="text-3xl font-medium text-primary tabular-nums mt-4 privacy-sensitive">
    <%= debt_plan.total_balance_money.format(precision: 0) %>
  </p>
  <p class="text-xs text-secondary mt-1"><%= t(".total_balance") %></p>

  <div class="mt-4 pt-4 border-t border-subdued flex items-center justify-between gap-2">
    <div class="min-w-0">
      <p class="text-[11px] font-medium uppercase tracking-wide text-secondary"><%= t(".debt_free") %></p>
      <p class="text-sm font-medium text-primary truncate">
        <% if result.paid_off? %>
          <%= l(result.payoff_date, format: :long) %>
        <% else %>
          <%= t("debt_plans.status.#{result.status}.short") %>
        <% end %>
      </p>
    </div>
    <div class="text-right shrink-0">
      <p class="text-[11px] font-medium uppercase tracking-wide text-secondary"><%= t(".budget") %></p>
      <p class="text-sm font-medium text-primary tabular-nums privacy-sensitive">
        <%= t(".per_month", amount: debt_plan.monthly_budget_money.format(precision: 0)) %>
      </p>
    </div>
  </div>
<% end %>
