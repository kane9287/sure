<%# locals: (debt_plan:, comparison:) %>

<section class="bg-container rounded-xl shadow-border-xs p-5 space-y-4">
  <div>
    <h2 class="text-[11px] font-medium uppercase tracking-wide text-secondary"><%= t("debt_plans.comparison.heading") %></h2>
    <p class="text-sm text-primary mt-2 privacy-sensitive">
      <% if comparison.interest_saved.positive? %>
        <%= t("debt_plans.comparison.avalanche_saves",
               amount: Money.new(comparison.interest_saved, debt_plan.currency).format(precision: 0)) %>
      <% else %>
        <%= t("debt_plans.comparison.interest_tie") %>
      <% end %>
      <% if comparison.first_payoff_months_saved.to_i.positive? %>
        <%= t("debt_plans.comparison.snowball_first_win", count: comparison.first_payoff_months_saved) %>
      <% end %>
    </p>
  </div>

  <div class="grid grid-cols-1 @2xl:grid-cols-2 gap-3">
    <% { "avalanche" => comparison.avalanche, "snowball" => comparison.snowball }.each do |name, result| %>
      <div class="bg-container-inset rounded-lg p-4">
        <div class="flex items-center justify-between gap-2">
          <p class="text-sm font-medium text-primary"><%= t("debt_plans.strategies.#{name}") %></p>
          <% if debt_plan.strategy == name %>
            <%= render DS::Pill.new(label: t("debt_plans.comparison.selected"), tone: :neutral, marker: false) %>
          <% end %>
        </div>
        <p class="text-xs text-secondary mt-0.5"><%= t("debt_plans.strategies.#{name}_hint") %></p>

        <dl class="mt-3 space-y-1.5">
          <div class="flex items-baseline justify-between gap-2 text-sm">
            <dt class="text-secondary"><%= t("debt_plans.comparison.debt_free") %></dt>
            <dd class="text-primary tabular-nums"><%= l(result.payoff_date, format: :long) %></dd>
          </div>
          <div class="flex items-baseline justify-between gap-2 text-sm">
            <dt class="text-secondary"><%= t("debt_plans.comparison.total_interest") %></dt>
            <dd class="text-primary tabular-nums privacy-sensitive">
              <%= Money.new(result.total_interest, debt_plan.currency).format(precision: 0) %>
            </dd>
          </div>
        </dl>
      </div>
    <% end %>
  </div>
</section>
